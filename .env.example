# Local-only credentials for Docker Compose. Never reuse production credentials.
MYSQL_ROOT_PASSWORD=

IDENTITY_DB_USER=identity_local
IDENTITY_DB_PASSWORD=
PROPERTY_DB_USER=property_local
PROPERTY_DB_PASSWORD=
MAINTENANCE_DB_USER=maintenance_local
MAINTENANCE_DB_PASSWORD=
ASSET_DB_USER=asset_local
ASSET_DB_PASSWORD=
NOTIFICATION_DB_USER=notification_local
NOTIFICATION_DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional: creates the first SYSTEM_ADMIN only when the identity database has no users.
# Password must be 12-72 characters. Leave blank to skip; remove after first start.
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret for maintenance -> notification event delivery. Generate a unique local-only random value.
INTERNAL_API_KEY=

IDENTITY_DB_URL=jdbc:mysql://mysql:3306/facility_identity?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PROPERTY_DB_URL=jdbc:mysql://mysql:3306/facility_property?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MAINTENANCE_DB_URL=jdbc:mysql://mysql:3306/facility_maintenance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ASSET_DB_URL=jdbc:mysql://mysql:3306/facility_asset?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NOTIFICATION_DB_URL=jdbc:mysql://mysql:3306/facility_notification?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# DEV ONLY: password for the synthetic demo users created when SPRING_PROFILES_ACTIVE=dev-seed.
# Set locally to a unique value of 12-72 characters. Leave empty everywhere else; never use in production.
DEV_SEED_PASSWORD=
